 drawing-order="1" hint="" /><node index="1" text="Public Reads · 836 词" resource-id="tech.xiangzi.painless:id/article_author" class="android.widget.TextView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[280,643][798,719]" drawing-order="2" hint="" /></node><node index="2" text="" resource-id="tech.xiangzi.painless:id/article_rv" class="androidx.recyclerview.widget.RecyclerView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[80,761][1360,3168]" drawing-order="3" hint=""><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[80,821][1360,1659]" drawing-order="1" hint=""><node index="0" text="Young sailor Edmond Dantès was a happy and honest man. He loved a beautiful woman named Mercédès and was soon to become captain of his ship. His future was bright. But not everyone was happy for him.&#10;" resource-id="tech.xiangzi.painless:id/article_tv" class="android.widget.TextView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[80,821][1360,1423]" drawing-order="1" hint="" /><node index="1" text="年轻水手爱德蒙·邓蒂斯曾是个快乐而正直的人。他爱着美丽的梅塞苔丝，即将成为船上的船长。他的前途一片光明。但并非所有人都为他感到高兴。" resource-id="tech.xiangzi.painless:id/translate_tv" class="android.widget.TextView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[80,1367][1360,1599]" drawing-order="2" hint="" /></node><node index="1" text="" resource-id="" class="android.widget.LinearLayout" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[80,1659][1360,2783]" drawing-order="2" hint=""><node index="0" text="Three men were jealous of Edmond. Danglars, a fellow sailor, wanted his job. Fernand loved Mercédès and wanted her for himself. A lawyer named Villefort was afraid Edmond knew a dangerous political secret. Together, they wrote a letter accusing Edmond of being a traitor to the king.&#10;" resource-id="tech.xiangzi.painless:id/article_tv" class="android.widget.TextView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[80,1659][1360,2469]" drawing-order="1" hint="" /><node index="1" text="有三个人嫉妒爱德蒙。同事邓格拉斯想取代他的职位。费尔南爱慕梅塞苔丝，想将她据为己有。律师维尔福则害怕爱德蒙知晓一个危险的政治秘密。三人合谋写了一封指控爱德蒙背叛国王的告密信。" resource-id="tech.xiangzi.painless:id/translate_tv" class="android.widget.TextView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[80,2413][1360,2723]" drawing-order="2" hint="" /></node><node index="2" text="" resource-id="" class="android.widget.LinearLayout" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[80,2783][1360,3168]" drawing-order="3" hint=""><node index="0" text="On his wedding day, soldiers took Edmond away. He was brought to the island prison of the Château d'If. He was trapped in a cold, dark cell. He did not know why he was there, and no one would tell him. For many years, he suffered alone. He lost all hope and decided to die by not eating.&#10;" resource-id="tech.xiangzi.painless:id/article_tv" class="android.widget.TextView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[80,2783][1360,3168]" drawing-order="1" hint="" /></node></node></node></node><node index="2" text="" resource-id="" class="android.widget.FrameLayout" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[300,2728][1140,3048]" drawing-order="3" hint=""><node index="0" text="" resource-id="tech.xiangzi.painless:id/article_action_rv" class="androidx.recyclerview.widget.RecyclerView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[340,2768][1100,3008]" drawing-order="1" hint=""><node index="0" text="" resource-id="tech.xiangzi.painless:id/stat_edit_tools_card" class="android.widget.FrameLayout" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[340,2768][580,3008]" drawing-order="1" hint=""><no