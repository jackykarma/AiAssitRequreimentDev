ing-order="1" hint="" /><node index="1" text="Public Reads · 303 词" resource-id="tech.xiangzi.painless:id/article_author" class="android.widget.TextView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[280,643][798,719]" drawing-order="2" hint="" /></node><node index="2" text="" resource-id="tech.xiangzi.painless:id/article_rv" class="androidx.recyclerview.widget.RecyclerView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[80,761][1360,3168]" drawing-order="3" hint=""><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[80,821][1360,1768]" drawing-order="1" hint=""><node index="0" text="After Jesus fed the five thousand people, he told his disciples to get into their boat and go to the other side of the lake. He stayed behind to say goodbye to the crowd. Later that evening, he went up on a mountainside by himself to pray.&#10;" resource-id="tech.xiangzi.painless:id/article_tv" class="android.widget.TextView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[80,821][1360,1532]" drawing-order="1" hint="" /><node index="1" text="耶稣喂饱五千人后，吩咐门徒上船先到湖对岸去，自己则留下来遣散众人。傍晚时分，他独自登上山坡祷告。" resource-id="tech.xiangzi.painless:id/translate_tv" class="android.widget.TextView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[80,1476][1360,1708]" drawing-order="2" hint="" /></node><node index="1" text="" resource-id="" class="android.widget.LinearLayout" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[80,1768][1360,2714]" drawing-order="2" hint=""><node index="0" text="The disciples were now in the middle of the lake. The weather changed. A strong wind began to blow, and big waves hit their boat. They were rowing hard, but the boat was not moving fast. It was a dark and scary night.&#10;" resource-id="tech.xiangzi.painless:id/article_tv" class="android.widget.TextView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[80,1768][1360,2478]" drawing-order="1" hint="" /><node index="1" text="门徒的船此时正行至湖心。天色骤变，狂风骤起，巨浪拍打着船身。他们奋力划桨，船却行进缓慢。这是个漆黑可怖的夜晚。" resource-id="tech.xiangzi.painless:id/translate_tv" class="android.widget.TextView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[80,2422][1360,2654]" drawing-order="2" hint="" /></node><node index="2" text="" resource-id="" class="android.widget.LinearLayout" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[80,2714][1360,3168]" drawing-order="3" hint=""><node index="0" text="Very early in the morning, while it was still dark, the disciples saw something. Someone was walking on the water, coming toward the boat. They were terrified. “It is a ghost!” they cried out in fear.&#10;" resource-id="tech.xiangzi.painless:id/article_tv" class="android.widget.TextView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[80,2714][1360,3168]" drawing-order="1" hint="" /></node></node></node></node><node index="2" text="" resource-id="" class="android.widget.FrameLayout" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[300,2728][1140,3048]" drawing-order="3" hint=""><node index="0" text="" resource-id="tech.xiangzi.painless:id/article_action_rv" class="androidx.recyclerview.widget.RecyclerView" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[340,2768][1100,3008]" drawing-order="1" hint=""><node index="0" text="" resource-id="tech.xiangzi.painless:id/stat_edit_tools_card" class="android.widget.FrameLayout" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[340,2768][580,3008]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="tech.xiangzi.painless" content-desc="" checkable="false" checked="false" clickable="fal